#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        // BT_CLR 호출을 위한 1인자 매크로
        bt_clr_macro: bt_clr_macro {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        // 노브 전용: 3초(3000ms) 홀드 -> 다음 레이어로 순환 전환 / 살짝 탭 -> 키 입력
        ht_to: hold_tap_to {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_TO";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <3000>;
            bindings = <&to>, <&kp>;
        };

        // 6번 스위치 전용: 5초(5000ms) 홀드 -> 블루투스 초기화 / 살짝 탭 -> 숫자 6 입력
        ht_bt: hold_tap_bt {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_BT";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <5000>;
            bindings = <&bt_clr_macro>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ==========================================
        // [레이어 1] (1번 LED 점등)
        // ==========================================
        layer_0 {
            sensor-bindings = <&inc_dec_kp A B>;
            bindings = <
                &kp N1            &kp N2          &kp N3
                &kp N4            &kp N5          &ht_bt 0 N6
                &ht_to 1 C
            >;
        };

        // ==========================================
        // [레이어 2] (2번 LED 점등)
        // ==========================================
        layer_1 {
            sensor-bindings = <&inc_dec_kp D E>;
            bindings = <
                &kp N1            &kp N2          &kp N3
                &kp N4            &kp N5          &ht_bt 0 N6
                &ht_to 2 F
            >;
        };

        // ==========================================
        // [레이어 3] (3번 LED 점등)
        // ==========================================
        layer_2 {
            sensor-bindings = <&inc_dec_kp G H>;
            bindings = <
                &kp N1            &kp N2          &kp N3
                &kp N4            &kp N5          &ht_bt 0 N6
                &ht_to 3 I
            >;
        };

        // ==========================================
        // [레이어 4] (4번 LED 점등)
        // ==========================================
        layer_3 {
            sensor-bindings = <&inc_dec_kp J K>;
            bindings = <
                &kp N1            &kp N2          &kp N3
                &kp N4            &kp N5          &ht_bt 0 N6
                &ht_to 0 L
            >;
        };
    };
};
